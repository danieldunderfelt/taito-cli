{
  "name": "taito-cli",
    "version": "1.3.0",
  "description": "CLI for initializing projects from customizable templates and managing customizable Agent Skills.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Dunderfelt <daniel@developsuperpowers.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/danieldunderfelt/taito-cli"
  },
  "keywords": [
    "cli",
    "project-template",
    "boilerplate",
    "scaffolding",
    "agent-skills",
    "cursor",
    "windsurf",
    "claude-code",
    "ai-coding",
    "ai-assistant",
    "skills",
    "customizable"
  ],
  "bin": {
    "taito": "./scripts/run.sh"
  },
  "files": [
    "dist",
    "scripts/run.sh",
    "scripts/run.cmd",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run bin/taito.ts",
    "build": "bun run scripts/build.ts",
    "build:local": "bun build --compile ./bin/taito.ts --outfile ./dist/taito",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@types/bun": "^1.3.14",
    "@types/ejs": "3.1.5",
    "commander": "15.0.0",
    "ejs": "6.0.1",
    "json5": "2.2.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "smol-toml": "1.7.0",
    "tar": "7.5.20",
    "typescript": "7.0.2"
  }
}
